# Postgres
POSTGRES_PASSWORD=changeme

# App database URL (constructed from the above)
DATABASE_URL=postgresql://dealbrain:changeme@localhost:5432/dealbrain

# Log level
LOG_LEVEL=INFO

# Tailscale / VPS networking
# On the VPS set this to the output of: tailscale ip -4
# For local development leave as 127.0.0.1
TAILSCALE_IP=127.0.0.1

# Deploy target (not passed to docker compose — used by infra/deploy.sh)
# DEALBRAIN_HOST=100.x.x.x   # VPS Tailscale IP
# DEALBRAIN_USER=dealbrain
